# Firebase Functions Environment Variables
# Set these with: firebase functions:config:set resend.api_key="your_key_here"

# Example:
# firebase functions:config:set resend.api_key="re_your_api_key_here"
# firebase functions:config:set contact.email="your-email@example.com"

# For local development, create a .env file in the functions directory with:
# RESEND_API_KEY=your_resend_api_key_here
# CONTACT_EMAIL=your-email@example.com
# --- GA4 reporting (getAnalyticsReport) ---
# Numeric property id from GA Admin -> Property Settings.
# NOT the G-XXXXXXX measurement id.
# GA4_PROPERTY_ID=123456789
#
# Comma-separated emails allowed to read analytics. Leave unset and ANY
# signed-in Firebase user can read the report.
# ANALYTICS_ALLOWED_EMAILS=you@example.com
